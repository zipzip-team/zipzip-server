Project zipzip {
  database_type: 'PostgreSQL'
  Note: 'Zipzip 1차 공유 폴더 서버 데이터 모델. 애플리케이션에서 UUID를 생성하고 시간은 UTC timestamptz로 저장한다. DBML이 표현하지 못하는 PostgreSQL partial/expression index는 postgresql-overrides.sql을 함께 적용한다.'
}

Enum shared_folder_role {
  HOST [note: '공유 폴더를 만든 방장. 공유 폴더 삭제 권한을 가진다.']
  MEMBER [note: '초대 코드로 공유 폴더에 참여한 멤버.']
}

Table app_user {
  id uuid [pk, not null, note: '애플리케이션에서 생성하는 사용자 식별자']
  apple_subject varchar(255) [not null, unique, note: 'Apple 로그인으로 받은 변경되지 않는 사용자 식별자']
  display_name varchar(50) [not null, note: '공유 폴더 참여자와 콘텐츠 작성자 표시에 사용하는 사용자 이름']
  created_at timestamptz [not null, default: `now()`, note: '사용자 최초 등록 시각']
  updated_at timestamptz [not null, default: `now()`, note: '사용자 정보 마지막 수정 시각. 애플리케이션에서 갱신한다.']
  deleted_at timestamptz [note: '사용자 탈퇴 시각. null이면 활성 사용자']

  indexes {
    deleted_at [name: 'idx_app_user__deleted_at']
  }

  checks {
    `char_length(btrim(display_name)) > 0` [name: 'chk_app_user__display_name_not_blank']
  }

  Note: 'Apple 로그인 후 서버에 등록된 사용자. 동일한 Apple 계정으로 재가입하면 이 행을 복구한다.'
}

Table refresh_token {
  id uuid [pk, not null, note: '애플리케이션에서 생성하는 Refresh Token 행 식별자']
  app_user_id uuid [not null, note: 'Refresh Token을 소유한 사용자 식별자']
  token_hash varchar(255) [not null, unique, note: 'Refresh Token 원문의 해시값']
  token_family_id uuid [not null, note: '같은 로그인 세션에서 회전된 Refresh Token 계열 식별자']
  expires_at timestamptz [not null, note: 'Refresh Token 만료 시각']
  revoked_at timestamptz [note: '로그아웃, 회전 또는 재사용 탐지로 토큰을 폐기한 시각']
  replaced_by_refresh_token_id uuid [unique, note: '회전 후 발급된 다음 Refresh Token 행 식별자']
  created_at timestamptz [not null, default: `now()`, note: 'Refresh Token 발급 시각']
  updated_at timestamptz [not null, default: `now()`, note: 'Refresh Token 상태 마지막 수정 시각']

  indexes {
    (app_user_id, token_family_id) [name: 'idx_refresh_token__app_user_id_token_family_id']
    expires_at [name: 'idx_refresh_token__expires_at']
    revoked_at [name: 'idx_refresh_token__revoked_at']
  }

  checks {
    `expires_at > created_at` [name: 'chk_refresh_token__expires_after_created']
    `revoked_at is null or revoked_at >= created_at` [name: 'chk_refresh_token__revoked_after_created']
  }

  Note: '다중 로그인 세션과 Refresh Token 회전을 지원한다. 원문은 저장하지 않고 폐기 또는 만료 후 배치로 정리한다.'
}

Table invite_code_reservation {
  invite_code varchar(64) [pk, not null, note: '과거에 발급한 값을 포함해 영구 예약하는 공유 폴더 초대 코드']
  created_at timestamptz [not null, default: `now()`, note: '초대 코드 최초 예약 시각']

  checks {
    `char_length(btrim(invite_code)) > 0` [name: 'chk_invite_code_reservation__invite_code_not_blank']
  }

  Note: '초대 코드의 영구 비재사용을 보장하는 예약 원장. 공유 폴더를 물리 삭제한 뒤에도 행을 삭제하지 않는다. 주요 업무 엔티티가 아니므로 UUID id와 updated_at을 두지 않는 표준 예외다.'
}

Table shared_folder {
  id uuid [pk, not null, note: '애플리케이션에서 생성하는 공유 폴더 식별자']
  created_by_app_user_id uuid [not null, note: '공유 폴더를 최초 생성한 사용자 식별자']
  name varchar(100) [not null, note: '공유 뷰와 공유 폴더 내부 상단에 표시하는 이름']
  invite_code varchar(64) [not null, unique, note: '공유 폴더 참여에 사용하는 고정 초대 코드']
  created_at timestamptz [not null, default: `now()`, note: '공유 폴더 생성 시각']
  updated_at timestamptz [not null, default: `now()`, note: '공유 폴더 정보 마지막 수정 시각']
  deleted_at timestamptz [note: '방장이 공유 폴더를 삭제한 시각. null이면 활성 공유 폴더']

  indexes {
    (created_by_app_user_id, deleted_at) [name: 'idx_shared_folder__created_by_app_user_id_deleted_at']
    deleted_at [name: 'idx_shared_folder__deleted_at']
  }

  checks {
    `char_length(btrim(name)) > 0` [name: 'chk_shared_folder__name_not_blank']
    `char_length(btrim(invite_code)) > 0` [name: 'chk_shared_folder__invite_code_not_blank']
  }

  Note: '공유 뷰에 카드로 표시되는 실제 공유 공간. 초대, 멤버십, 관리, 앨범과 사진 댓글 채팅 뷰의 조회 루트이다.'
}

Table shared_folder_membership {
  id uuid [pk, not null, note: '애플리케이션에서 생성하는 공유 폴더 멤버십 식별자']
  shared_folder_id uuid [not null, note: '참여한 공유 폴더 식별자']
  app_user_id uuid [not null, note: '공유 폴더에 참여한 사용자 식별자']
  role shared_folder_role [not null, note: '공유 폴더 안에서 사용자의 방장 또는 멤버 역할']
  created_at timestamptz [not null, default: `now()`, note: '공유 폴더에 참여한 시각']
  updated_at timestamptz [not null, default: `now()`, note: '멤버십 정보 마지막 수정 시각']

  indexes {
    (shared_folder_id, created_at) [name: 'idx_shared_folder_membership__folder_created']
    (app_user_id, created_at) [name: 'idx_shared_folder_membership__user_created']
    (shared_folder_id, app_user_id) [unique, name: 'uk_shared_folder_membership__folder_user']
    (shared_folder_id, role) [name: 'idx_shared_folder_membership__folder_role']
  }

  Note: '사용자와 공유 폴더의 현재 참여 관계. 멤버 나가기 또는 Zipzip 서비스 탈퇴 시 MEMBER 행을 물리 삭제한다. PostgreSQL DDL에서는 공유 폴더별 HOST 한 명 partial unique를 추가한다.'
}

Table device {
  id uuid [pk, not null, note: '애플리케이션에서 생성하는 기기 태그 식별자']
  app_user_id uuid [not null, note: '기기 태그를 소유한 사용자 식별자']
  name varchar(100) [not null, note: '화면에 표시하는 주 사용 촬영 기기 이름']
  created_at timestamptz [not null, default: `now()`, note: '기기 태그 등록 시각']
  updated_at timestamptz [not null, default: `now()`, note: '기기 태그 마지막 수정 시각']
  deleted_at timestamptz [note: '기기 태그 삭제 시각. null이면 활성 태그']

  indexes {
    (app_user_id, deleted_at, created_at) [name: 'idx_device__app_user_id_deleted_at_created_at']
    (app_user_id, name, deleted_at) [name: 'idx_device__user_name_deleted']
  }

  checks {
    `char_length(btrim(name)) > 0` [name: 'chk_device__name_not_blank']
  }

  Note: '물리 장비 식별자가 아닌 사용자의 주 사용 촬영 기기 표시용 태그. postgresql-overrides.sql에서 lower(btrim(name)) 표현식과 deleted_at is null 조건으로 활성 태그의 중복을 방지한다.'
}

Table shared_album {
  id uuid [pk, not null, note: '애플리케이션에서 생성하는 앨범 식별자']
  shared_folder_id uuid [not null, note: '앨범이 속한 공유 폴더 식별자']
  created_by_app_user_id uuid [not null, note: '앨범을 생성한 사용자이며 삭제 권한의 기준']
  name varchar(100) [not null, note: '공유 폴더 내부에 표시하는 앨범 이름']
  created_at timestamptz [not null, default: `now()`, note: '앨범 생성 시각']
  updated_at timestamptz [not null, default: `now()`, note: '앨범 정보 마지막 수정 시각']
  deleted_at timestamptz [note: '앨범 삭제 시각. null이면 활성 앨범']

  indexes {
    (shared_folder_id, deleted_at, created_at) [name: 'idx_shared_album__shared_folder_id_deleted_at_created_at']
    (created_by_app_user_id, deleted_at) [name: 'idx_shared_album__created_by_app_user_id_deleted_at']
    deleted_at [name: 'idx_shared_album__deleted_at']
  }

  checks {
    `char_length(btrim(name)) > 0` [name: 'chk_shared_album__name_not_blank']
  }

  Note: '공유 폴더 참여자가 생성하는 사진 묶음. 사진 없이도 존재할 수 있으며 활성 멤버가 이름을 수정할 수 있고 생성자만 삭제한다.'
}

Table shared_album_photo {
  id uuid [pk, not null, note: '애플리케이션에서 생성하는 앨범 사진 포함 관계 식별자']
  shared_album_id uuid [not null, note: '사진을 포함하는 앨범 식별자']
  photo_id uuid [not null, note: '앨범에 포함된 사진 식별자']
  added_by_app_user_id uuid [not null, note: '사진을 앨범에 추가한 사용자 식별자']
  created_at timestamptz [not null, default: `now()`, note: '사진을 앨범에 추가한 시각']

  indexes {
    (shared_album_id, photo_id) [unique, name: 'uk_shared_album_photo__album_photo']
    (photo_id, shared_album_id) [name: 'idx_shared_album_photo__photo_album']
    (added_by_app_user_id, created_at) [name: 'idx_shared_album_photo__added_by_created_at']
  }

  Note: '사진과 앨범의 포함 관계. 한 사진이 여러 앨범에 들어갈 수 있으며, 앨범에서만 제거하면 이 행을 물리 삭제한다.'
}

Table photo {
  id uuid [pk, not null, note: '애플리케이션에서 생성하는 사진 식별자']
  shared_folder_id uuid [not null, note: '사진 원본이 속한 공유 폴더 식별자']
  uploaded_by_app_user_id uuid [not null, note: '사진을 업로드한 사용자이며 원본 수정과 삭제 권한의 기준']
  object_key text [not null, unique, note: 'OCI Object Storage에서 이미지 객체를 찾는 고유 키']
  original_file_name varchar(255) [not null, note: '업로드 당시 원본 파일명']
  content_type varchar(100) [not null, note: '이미지 MIME type']
  file_size bigint [not null, note: '이미지 파일 크기. byte 단위']
  taken_at timestamptz [note: '서버가 이미지 EXIF에서 추출한 사진 촬영일시. 없으면 created_at을 표시와 정렬 기준으로 사용']
  created_at timestamptz [not null, default: `now()`, note: '사진 등록 시각']
  updated_at timestamptz [not null, default: `now()`, note: '사진 정보 마지막 수정 시각']
  deleted_at timestamptz [note: '사진 삭제 시각. null이면 활성 사진']

  indexes {
    (shared_folder_id, deleted_at, id) [name: 'idx_photo__folder_active_id']
    (uploaded_by_app_user_id, deleted_at) [name: 'idx_photo__uploaded_by_app_user_id_deleted_at']
    deleted_at [name: 'idx_photo__deleted_at']
  }

  checks {
    `file_size > 0` [name: 'chk_photo__file_size_positive']
    `content_type like 'image/%'` [name: 'chk_photo__content_type_image']
    `char_length(btrim(original_file_name)) > 0` [name: 'chk_photo__original_file_name_not_blank']
  }

  Note: '공유 폴더의 사진 원본 파일 참조 정보. 서버는 이미지 EXIF에서 촬영일시만 추출해 taken_at에 저장하고, EXIF를 제거하지 않은 원본 이미지 파일은 OCI Object Storage에 저장한다. 앨범 포함 관계는 shared_album_photo가 표현하고, 촬영일 우선 정렬용 coalesce 표현식 partial index는 postgresql-overrides.sql에 정의한다.'
}

Table photo_like {
  id uuid [pk, not null, note: '애플리케이션에서 생성하는 사진 좋아요 식별자']
  photo_id uuid [not null, note: '좋아요 대상 사진 식별자']
  app_user_id uuid [not null, note: '좋아요를 누른 사용자 식별자']
  created_at timestamptz [not null, default: `now()`, note: '좋아요 생성 시각']
  updated_at timestamptz [not null, default: `now()`, note: '좋아요 행 마지막 수정 시각']

  indexes {
    (photo_id, app_user_id) [unique, name: 'uk_photo_like__photo_id_app_user_id']
    (app_user_id, created_at) [name: 'idx_photo_like__app_user_id_created_at']
  }

  Note: '사진별 단순 좋아요 상태. 활성 멤버이면서 해당 좋아요를 누른 사용자만 취소할 수 있고, 취소 시 행을 물리 삭제한다.'
}

Table photo_comment {
  id uuid [pk, not null, note: '애플리케이션에서 생성하는 사진 댓글 식별자']
  photo_id uuid [not null, note: '댓글 대상 사진 식별자']
  app_user_id uuid [not null, note: '댓글 작성 사용자 식별자']
  content varchar(1000) [not null, note: '사진 댓글 본문. 최대 1,000자']
  created_at timestamptz [not null, default: `now()`, note: '댓글 작성 시각']
  updated_at timestamptz [not null, default: `now()`, note: '댓글 마지막 수정 시각']
  deleted_at timestamptz [note: '댓글 삭제 시각. null이면 활성 댓글']

  indexes {
    (photo_id, deleted_at, created_at) [name: 'idx_photo_comment__photo_id_deleted_at_created_at']
    (app_user_id, deleted_at) [name: 'idx_photo_comment__app_user_id_deleted_at']
    (deleted_at, created_at, id) [name: 'idx_photo_comment__active_created_id']
  }

  checks {
    `char_length(btrim(content)) > 0` [name: 'chk_photo_comment__content_not_blank']
  }

  Note: '단일 사진에 달리는 댓글. 공유 폴더 채팅은 별도 메시지 테이블이 아니라 이 댓글을 공유 폴더 범위로 모아 보여주는 뷰이다.'
}

Ref fk_refresh_token__app_user: app_user.id < refresh_token.app_user_id [delete: cascade, update: no action]
Ref fk_refresh_token__replaced_by: refresh_token.id - refresh_token.replaced_by_refresh_token_id [delete: set null, update: no action]

Ref fk_shared_folder__invite_code_reservation: invite_code_reservation.invite_code - shared_folder.invite_code [delete: restrict, update: no action]
Ref fk_shared_folder__created_by_app_user: app_user.id < shared_folder.created_by_app_user_id [delete: restrict, update: no action]
Ref fk_shared_folder_membership__shared_folder: shared_folder.id < shared_folder_membership.shared_folder_id [delete: cascade, update: no action]
Ref fk_shared_folder_membership__app_user: app_user.id < shared_folder_membership.app_user_id [delete: restrict, update: no action]

Ref fk_device__app_user: app_user.id < device.app_user_id [delete: cascade, update: no action]

Ref fk_shared_album__shared_folder: shared_folder.id < shared_album.shared_folder_id [delete: cascade, update: no action]
Ref fk_shared_album__created_by_app_user: app_user.id < shared_album.created_by_app_user_id [delete: restrict, update: no action]

Ref fk_shared_album_photo__shared_album: shared_album.id < shared_album_photo.shared_album_id [delete: cascade, update: no action]
Ref fk_shared_album_photo__photo: photo.id < shared_album_photo.photo_id [delete: cascade, update: no action]
Ref fk_shared_album_photo__added_by_app_user: app_user.id < shared_album_photo.added_by_app_user_id [delete: restrict, update: no action]

Ref fk_photo__shared_folder: shared_folder.id < photo.shared_folder_id [delete: cascade, update: no action]
Ref fk_photo__uploaded_by_app_user: app_user.id < photo.uploaded_by_app_user_id [delete: restrict, update: no action]

Ref fk_photo_like__photo: photo.id < photo_like.photo_id [delete: cascade, update: no action]
Ref fk_photo_like__app_user: app_user.id < photo_like.app_user_id [delete: cascade, update: no action]

Ref fk_photo_comment__photo: photo.id < photo_comment.photo_id [delete: cascade, update: no action]
Ref fk_photo_comment__app_user: app_user.id < photo_comment.app_user_id [delete: restrict, update: no action]

TableGroup authentication [note: '사용자 인증과 세션'] {
  app_user
  refresh_token
}

TableGroup shared_folder_domain [note: '공유 폴더, 참여 관계, 표시용 기기'] {
  invite_code_reservation
  shared_folder
  shared_folder_membership
  device
}

TableGroup photo_domain [note: '앨범과 사진 상호작용'] {
  shared_album
  shared_album_photo
  photo
  photo_like
  photo_comment
}
